[Unit]
Description=BitBank account-backed experimental paper trader
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/bitbankpoloniex
ExecStart=%h/bitbankpoloniex/bin/bitbankpoloniex --command run --state data/account-paper-v2 --experimental-fallback
Restart=on-failure
RestartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/bitbankpoloniex/data

[Install]
WantedBy=default.target
