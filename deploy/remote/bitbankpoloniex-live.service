[Unit]
Description=BitBank Poloniex live trader (real orders; existing operator budget)
Wants=network-online.target
After=network-online.target bitbankgo.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/nvme0n1-disk/code/bitbank-poloniex
ExecStartPre=/usr/bin/test -s /nvme0n1-disk/code/bitbank-poloniex/data/live/state.json
ExecStart=/nvme0n1-disk/code/bitbank-poloniex/bin/bitbankpoloniex --command run --mode live --state data/live --budget 495 --max-order 49 --slots 3 --enable-live-orders --predictions http://127.0.0.1:8745/api/trading-bot/rotation-signals --env /nvme0n1-disk/code/bitbank-poloniex/.env
Restart=on-failure
RestartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/nvme0n1-disk/code/bitbank-poloniex/data

[Install]
WantedBy=multi-user.target
