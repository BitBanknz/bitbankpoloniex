[Unit]
Description=BitBank Poloniex paper trader
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/bitbankpoloniex
ExecStart=%h/bitbankpoloniex/bin/bitbankpoloniex --command run --mode paper --state data/paper
Restart=on-failure
RestartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/bitbankpoloniex/data

[Install]
WantedBy=default.target
